{
  "manifest_version": 3,
  "name": "evrything-about-me browser capture",
  "short_name": "EAM capture",
  "version": "0.1.0",
  "description": "Records bounded browsing metadata and source-authorized page text to the local evrything-about-me host.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "key": "",
  "permissions": ["alarms", "scripting", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:43129/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "evrything-about-me capture",
    "default_popup": "popup.html"
  }
}
